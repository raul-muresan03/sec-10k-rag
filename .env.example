# Required to download a filing, from either the local browser or the operator shell
SEC_API_EMAIL=your_email@example.com

# Local browser: http://localhost:8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
EMBEDDING_BATCH_SIZE=512

# Live API defaults (Compose overrides OLLAMA_BASE_URL with the internal service address)
RAG_RUNTIME=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
RAG_MODEL=gemma3:1b
RAG_TOP_N=5
RAG_MAX_CONCURRENT_GENERATIONS=1

# browser for local Compose; operator for a public deployment (prepare via operator shell instead)
FILING_PREPARATION_ACCESS=browser

# Cloud provider adapters only; complete cloud filing queries await the immutable snapshot release.
# Replace local RAG_MODEL and FILING_PREPARATION_ACCESS when selecting RAG_RUNTIME=cloud.
# RAG_RUNTIME=cloud
# RAG_MODEL=openai/gpt-oss-20b
# FILING_PREPARATION_ACCESS=operator
# CLOUD_TIMEOUT_SECONDS=30
# Configure GROQ_API_KEY, CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID securely in the backend environment.
# Never put credentials in VITE_* variables, committed files, browser code or logs.
