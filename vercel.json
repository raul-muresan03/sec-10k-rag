{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api.main:app",
      "functions": {
        "api/main.py": {
          "maxDuration": 120,
          "includeFiles": "deploy/indexes/**",
          "excludeFiles": "frontend/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
